{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/login.html",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/tests.html",
      "destination": "/tests",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/instructions.html",
      "destination": "/instructions",
      "permanent": true
    },
    {
      "source": "/exam.html",
      "destination": "/exam",
      "permanent": true
    },
    {
      "source": "/result.html",
      "destination": "/result",
      "permanent": true
    },
    {
      "source": "/review.html",
      "destination": "/review",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/login.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/tests",
      "destination": "/tests.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/exam",
      "destination": "/exam.html"
    },
    {
      "source": "/instructions",
      "destination": "/instructions.html"
    },
    {
      "source": "/result",
      "destination": "/result.html"
    },
    {
      "source": "/review",
      "destination": "/review.html"
    }
  ]
}
